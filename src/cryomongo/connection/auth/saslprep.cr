  def prepare(str : String) : String
    return str if ascii_safe?(str)

    mapped = map(str)
    normalized = mapped.unicode_normalize(:nfkc)
    check_prohibited!(normalized)
    check_bidi!(normalized)
    normalized
  end

  # Printable ASCII needs no mapping, no NFKC, and is not prohibited.
  private def ascii_safe?(str : String) : Bool
    str.each_byte do |byte|
      return false if byte < 0x20 || byte > 0x7E
    end
    true
  end

  private def map(str : String) : String
    String.build(str.bytesize) do |io|
      str.each_char do |ch|
        code = ch.ord.to_u32
        if in_table?(code, C12)
          io << ' '
        elsif in_table?(code, B1)
          # mapped to nothing
        else
          io << ch
        end
      end
    end
  end

  private def check_prohibited!(str : String) : Nil
    str.each_char do |ch|
      if in_table?(ch.ord.to_u32, PROHIBITED)
        raise Mongo::Error.new("SASLprep failed: prohibited character U+#{ch.ord.to_s(16).upcase}")
      end
    end
  end

  private def check_bidi!(str : String) : Nil
    has_ral = false
    has_l = false
    first_ral = false
    last_ral = false
    first = true
    str.each_char do |ch|
      code = ch.ord.to_u32
      ral = in_table?(code, D1)
      lcat = in_table?(code, D2)
      has_ral ||= ral
      has_l ||= lcat
      if first
        first_ral = ral
        first = false
      end
      last_ral = ral
    end
    return unless has_ral
    if has_l || !first_ral || !last_ral
      raise Mongo::Error.new("SASLprep failed: bidirectional check")
    end
  end

  # Inclusive [start, end] pairs, sorted. Binary search, no allocation.
  private def in_table?(code : UInt32, table : Array(UInt32)) : Bool
    lo = 0
    hi = table.size // 2
    while lo < hi
      mid = (lo + hi) // 2
      start = table.unsafe_fetch(mid * 2)
      last = table.unsafe_fetch(mid * 2 + 1)
      if code < start
        hi = mid
      elsif code > last
        lo = mid + 1
      else
        return true
      end
    end
    false
  end
end
